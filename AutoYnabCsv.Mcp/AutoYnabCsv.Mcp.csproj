<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Company>github.com/d-led</Company>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>AutoYnabCsv.Mcp</RootNamespace>
    <!-- The name an editor puts in `command`: no dotnet, no path juggling, no runtime to install. -->
    <AssemblyName>auto-ynab-csv-mcp</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoYnabCsv.Ynab\AutoYnabCsv.Ynab.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

</Project>
