<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>AutoYnabCsv.DesktopApp</AssemblyName>
        <RootNamespace>AutoYnabCsv.DesktopApp</RootNamespace>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- Compressing the single file is only supported for a self-contained publish
             (NETSDK1176). A .app handed to someone has to bring its runtime anyway; a build
             without a runtime identifier stays framework-dependent and is unaffected. -->
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
        <PublishTrimmed>false</PublishTrimmed>
        <DebugType>embedded</DebugType>
        <LangVersion>latest</LangVersion>
        <PackageId>AutoYnabCsv.DesktopApp</PackageId>
        <Authors>github.com/d-led</Authors>
        <Company>github.com/d-led</Company>
        <Product>AutoYnabCsv.DesktopApp</Product>
        <Description>Automatic conversion of various banking exports into YNAB CSV (limited functionality)</Description>
        <Copyright>Dmitry Ledentsov 2024-2025</Copyright>
        <PackageProjectUrl>https://github.com/d-led/auto-ynab-csv</PackageProjectUrl>
        <PackageLicenseUrl>https://raw.githubusercontent.com/d-led/auto-ynab-csv/refs/heads/main/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/d-led/auto-ynab-csv</RepositoryUrl>
        <RepositoryType>Github</RepositoryType>
        <Version>0.0.3</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <CFBundleShortVersionString>$(Version)</CFBundleShortVersionString>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <UseAppHost>true</UseAppHost>
        <ApplicationIcon>Resources/Icons/app-icon.ico</ApplicationIcon>
        <RuntimeIdentifiers>osx-x64;osx-arm64;win-x64;win-arm64;linux-musl-x64;linux-musl-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <!--Deprecated by its authors; ReactiveUI.Avalonia is the replacement.-->
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Dotnet.Bundle" Version="0.9.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AutoYnabCsv\AutoYnabCsv.csproj" />
      <ProjectReference Include="..\AutoYnabCsv.MailIndex\AutoYnabCsv.MailIndex.csproj" />
    </ItemGroup>

        <ItemGroup>
            <None Include="Resources/Icons/app-icon.icns">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <TargetPath>$(AssemblyName).icns</TargetPath>
            </None>
        </ItemGroup>
</Project>
