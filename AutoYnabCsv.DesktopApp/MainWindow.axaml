<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AutoYnabCsv.DesktopApp.MainWindow"
        xmlns:vm="using:AutoYnabCsv.DesktopApp.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        Title="AutoYnabCsv.DesktopApp"
        MinWidth="560"
        MinHeight="380"
        MaxHeight="1200"
        MaxWidth="1700"
        Width="640"
        Height="600"
        Padding="10">

    <Grid DragDrop.AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="10">
            Drop exported CSV files here
        </TextBlock>
        <TextBox Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="10" Padding="10"
                 Text="{Binding Log}">
        </TextBox>
        <StackPanel Grid.Row="2" Margin="10,0,10,10" Spacing="6">
            <TextBlock Text="Dropped files convert next to themselves; the report for a run lands in auto-ynab-report/ in the folder of the first file dropped."
                       TextWrapping="Wrap" FontSize="12"></TextBlock>
            <ItemsControl ItemsSource="{Binding Locations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocationRow">
                        <Grid ColumnDefinitions="88,*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                       Foreground="Gray" VerticalAlignment="Top"></TextBlock>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Path}"
                                                 FontFamily="Menlo, Consolas, monospace" FontSize="11"
                                                 TextWrapping="Wrap"></SelectableTextBlock>
                            <Button Grid.Column="2" Content="Show" FontSize="11" Padding="8,2"
                                    Margin="8,0,0,0" Click="OnShowLocation"></Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Orientation="Horizontal">
                <Button Content="Config…" Click="OnEditConfig" Margin="0,0,6,6"></Button>
                <Button Content="Index mail" Click="OnIndexMail" Margin="0,0,6,6"></Button>
                <Button Content="Export report" Click="OnExportReport" Margin="0,0,6,6"></Button>
            </WrapPanel>
            <TextBlock Text="{Binding MailStatus}" FontSize="11" TextWrapping="Wrap"></TextBlock>
        </StackPanel>
    </Grid>
</Window>